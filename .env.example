# ---- Vibe Hunting environment ----

# OpenStreetMap APIs (REQUIRED to fetch leads)
# Vibe Hunting does not bundle built-in OpenStreetMap API endpoints.
# Add your own Overpass API and Nominatim API endpoints below (comma-separated for multiple Overpass mirrors).
OVERPASS_API_URL=
NOMINATIM_API_URL=

# Contact address sent in the Nominatim User-Agent header (their usage policy asks for one)
NOMINATIM_CONTACT=your-email@example.com

# AI outreach generation — https://console.groq.com  (free: 14,400 req/day)
# Server-side only. Without it, /api/generate returns a clear "not configured" error.
GROQ_API_KEY=

# Database + Auth — https://supabase.com (free forever tier)
# Both are public/browser-safe values (the anon key is protected by RLS).
# Leave BOTH blank to run Vibe Hunting in Local Mode (leads saved in browser localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
